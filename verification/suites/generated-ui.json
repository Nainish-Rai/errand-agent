{
  "version": 1,
  "title": "Generated UI in chat: photo choice cards, Choose leads to the fixed card, the ask form, charts, and the text fallback",
  "feature": "generated-ui",
  "description": "Ticket 17. Search options render as provider choice cards with service photos and world facts; Choose sends an ordinary message, the agent holds the slot and shows the fixed approval card, and nothing is booked until Approve. An ask form shows only the missing field and fills the errand. Charts show the world's numbers. A pick-one list offering Approve is refused and never drawn, and a tapped Yes books nothing. A program that doesn't parse falls back to text with the parse error in the trace.",
  "scenarios": [
    {
      "id": "choice-cards-choose-then-approve",
      "title": "Photo choice cards; Choose Shiva holds the slot and shows the approval card; nothing is booked until Approve ₹399",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "happy_path",
              "seed": 42
            }
          },
          "note": "seed the world: happy_path, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/memory"
          ],
          "options": {
            "body": {
              "facts": []
            }
          },
          "note": "start with nothing remembered"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Here are the best match, the cheapest and the earliest plumber in Koramangala this week. Which one should I book?"
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "hold_slot",
                            "input": {
                              "provider_id": "prv_plumber_koramangala_5",
                              "slot": {
                                "start": "2026-11-05T08:00:00+05:30",
                                "end": "2026-11-05T09:00:00+05:30"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "propose_action",
                            "input": {
                              "action": "book"
                            }
                          }
                        ]
                      },
                      {
                        "text": "I've held the slot. Check the card and tap Approve ₹399 if it's right."
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "execute_proposal",
                            "input": {}
                          }
                        ]
                      },
                      {
                        "text": "Booked: Shiva Sanitary Solutions, ₹399. Booking ID bkg_0002."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "the booking script: search, then hold and propose, then execute"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "Find a plumber in Koramangala this week"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=listitem"
          ],
          "options": {
            "count": 2
          },
          "note": "two tagged options as choice cards in one row"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Search results for plumber in Koramangala",
            "count": 0
          },
          "note": "one component: no second, plain list of the same providers"
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"] >> role=img"
          ],
          "options": {
            "count": 1
          },
          "note": "the card has its service photo"
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"]"
          ],
          "options": {
            "text": "₹399"
          },
          "note": "the world's price on the card"
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"]"
          ],
          "options": {
            "text": "Cheapest"
          },
          "note": "the tag as the card's highlight"
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"]"
          ],
          "options": {
            "text": "Earliest: Thu, 5 Nov, 8:00 am IST"
          },
          "note": "the world's earliest slot"
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Which one should I book?"
          },
          "note": "the first turn finished"
        },
        {
          "command": "theme",
          "args": [
            "light"
          ]
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"] >> role=img"
          ],
          "options": {
            "count": 1
          },
          "note": "the same cards in the light theme"
        },
        {
          "command": "theme",
          "args": [
            "dark"
          ]
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=listitem"
          ],
          "options": {
            "count": 2
          },
          "note": "back in the dark theme"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "See all 8"
          }
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Search results for plumber in Koramangala\"] >> role=listitem"
          ],
          "options": {
            "count": 8
          },
          "note": "See all lists all eight plumbers in a carousel"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Show fewer"
          }
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=listitem"
          ],
          "options": {
            "count": 2
          },
          "note": "back to the row of options"
        },
        {
          "command": "click",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"] >> role=button[name=\"Details\"]"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Shiva Sanitary Solutions details",
            "text": "Cancellation:"
          },
          "note": "Details opens the provider panel with its terms"
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Shiva Sanitary Solutions details\"] >> role=img"
          ],
          "options": {
            "count": 4
          },
          "note": "a gallery of four service photos"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": [
              {
                "path": "bookings",
                "length": 3
              },
              {
                "path": "bookings[*].approval",
                "equals": [
                  null,
                  null,
                  null
                ]
              }
            ]
          },
          "note": "world state: only the seeded history, nothing booked"
        },
        {
          "command": "click",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=article[name=\"Shiva Sanitary Solutions\"] >> role=button[name=\"Choose\"]"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "I'll take Shiva Sanitary Solutions, Thu, 5 Nov, 8:00 am IST."
          },
          "note": "Choose sent an ordinary message as the person"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve booking",
            "text": "Shiva Sanitary Solutions"
          },
          "note": "the agent held the slot and shows the fixed approval card"
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Approve ₹399",
            "state": "visible"
          },
          "note": "only the fixed card has an Approve button"
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Check the card and tap Approve"
          },
          "note": "the turn finished"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": [
              {
                "path": "bookings",
                "length": 3
              },
              {
                "path": "bookings[*].approval",
                "equals": [
                  null,
                  null,
                  null
                ]
              }
            ]
          },
          "note": "world state: Choose booked nothing"
        },
        {
          "command": "api",
          "args": [
