            "name": "Start an errand",
            "state": "visible"
          },
          "note": "with one action"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Memory",
            "text": "Nothing remembered yet"
          },
          "note": "Memory is empty"
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Area: not set",
            "state": "visible"
          },
          "note": "no remembered area, so the area chip is unset"
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Notifications",
            "state": "visible"
          },
          "note": "the bell has no count"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/home"
          ],
          "options": {
            "expect": [
              {
                "path": "working",
                "length": 0
              },
              {
                "path": "upcoming",
                "length": 0
              },
              {
                "path": "alerts",
                "length": 0
              },
              {
                "path": "memory",
                "length": 0
              },
              {
                "path": "counts.alerts",
                "equals": 0
              }
            ]
          },
          "note": "world state: the summary is empty too"
        },
        {
          "command": "screenshot",
          "args": [
            "empty-dark-desktop.png"
          ],
          "note": "every empty state"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Start an errand"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "textbox",
            "name": "Describe your errand",
            "state": "visible"
          },
          "note": "the chart's action takes the person to the composer"
        }
      ]
    },
    {
      "id": "theme-follows-system-then-the-toggle-persists",
      "title": "The theme follows the system (light) until toggled; dark then survives a reload, and so does light again",
      "viewport": "desktop",
      "theme": "light",
      "steps": [
        {
          "command": "goto",
          "args": [
            "/"
          ]
        },
        {
          "command": "assert",
          "options": {
            "attr": "data-theme=light"
          },
          "args": [
            "html"
          ],
          "note": "no saved choice: the home follows the system's light setting"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Switch to dark theme"
          }
        },
        {
          "command": "assert",
          "options": {
            "attr": "data-theme=dark"
          },
          "args": [
            "html"
          ],
          "note": "the toggle switches to dark"
        },
        {
          "command": "reload"
        },
        {
          "command": "assert",
          "options": {
            "attr": "data-theme=dark"
          },
          "args": [
            "html"
          ],
          "note": "the choice persists over the light system setting"
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Switch to light theme",
            "state": "visible"
          }
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Switch to light theme"
          }
        },
        {
          "command": "reload"
        },
        {
          "command": "assert",
          "options": {
            "attr": "data-theme=light"
          },
          "args": [
            "html"
          ],
          "note": "and light persists too"
        }
      ]
    },
    {
