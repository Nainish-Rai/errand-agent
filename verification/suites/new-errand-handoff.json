{
  "version": 1,
  "title": "New errand hand-off: a different job in a booked chat becomes a card that moves it to a new chat",
  "feature": "new-errand-handoff",
  "description": "Ticket 24. In a chat whose errand is booked, asking for a different job shows the New errand card (service, area, when from the refused search; the booking stays as it is; never an outcome code). Start in a new chat starts a session, saves the job as its errand before the first turn, sends the person's own words and moves there, with focus on the composer; the new chat says where it came from, the old chat shows Moved to a new chat · Open after a reload, and the booking is unchanged (API). Not now dismisses the card for good and the chat carries on.",
  "scenarios": [
    {
      "id": "move-to-new-chat-light",
      "title": "Book a plumber, ask for AC in HSR, Start in a new chat, land there with the job set, go back to the moved line (light, desktop)",
      "theme": "light",
      "viewport": "desktop",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "happy_path",
              "seed": 42
            }
          },
          "note": "seed the world: happy_path, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/memory"
          ],
          "options": {
            "body": {
              "facts": []
            }
          },
          "note": "no remembered facts"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Here are the best match, the cheapest and the earliest plumber in Koramangala this week. Which one should I book?"
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "hold_slot",
                            "input": {
                              "provider_id": "prv_plumber_koramangala_5",
                              "slot": {
                                "start": "2026-11-05T08:00:00+05:30",
                                "end": "2026-11-05T09:00:00+05:30"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "propose_action",
                            "input": {
                              "action": "book"
                            }
                          }
                        ]
                      },
                      {
                        "text": "I've held the slot. Check the card and tap Approve ₹399 if it's right."
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "execute_proposal",
                            "input": {}
                          }
                        ]
                      },
                      {
                        "text": "Booked: Shiva Sanitary Solutions, Thu 5 Nov at 8:00 am IST, ₹399. Booking ID bkg_0002."
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "ac_servicing",
                              "area": "HSR Layout",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "That's a new errand. Tap Start in a new chat and I'll pick it up there."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "the booking conversation, then a different job"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "Find a plumber in Koramangala this week"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Options for plumber in Koramangala",
            "state": "visible"
          },
          "note": "the plumber options render"
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "The cheapest one, please."
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Approve ₹399",
            "state": "visible"
          },
          "note": "the approval card is up"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Approve ₹399"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Booked",
            "text": "bkg_0002"
          },
          "note": "the plumber is booked"
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "She needs her AC repaired too, at my mom's place in HSR Layout."
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "text": "AC servicing"
          },
          "note": "the New errand card shows the new job's service"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "text": "HSR Layout"
          },
          "note": "its area"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "text": "Wed 4 Nov – Tue 10 Nov"
          },
          "note": "its when, from the search's date range"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "text": "Your plumber booking in Koramangala stays as it is."
          },
          "note": "the booking stays as it is"
        },
        {
          "command": "assert",
          "options": {
            "count": 0
          },
          "note": "never an outcome code",
          "args": [
            "text=not_editable"
          ]
        },
        {
          "command": "assert",
          "options": {
            "count": 0
          },
          "note": "the old plain line is gone",
          "args": [
            "text=wasn't searched again"
          ]
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.state",
                "equals": "done"
              },
              {
                "path": "errand.service",
                "equals": "plumber"
              }
            ]
          },
          "note": "the booked errand is unchanged"
        },
        {
          "command": "screenshot",
          "args": [
            "card-light.png"
          ],
          "options": {
            "viewport": true
          }
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "ac_servicing",
                              "area": "HSR Layout",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Here are AC servicing options in HSR Layout this week."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "the offline model counts turns per chat: load the new chat's first turn"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Start in a new chat"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "link",
            "name": "Open your Koramangala plumber chat",
            "state": "visible"
          },
          "note": "the new chat says where it came from"
        },
        {
          "command": "assert",
          "options": {
            "text": "Started from your Koramangala plumber chat"
          },
          "note": "Started from …",
          "args": [
            "body"
          ]
        },
        {
          "command": "assert",
          "options": {
            "text": "She needs her AC repaired too, at my mom's place in HSR Layout."
          },
          "note": "the person's own words are the new chat's first message",
          "args": [
            "body"
          ]
        },
        {
          "command": "assert",
          "args": [
            "textarea[aria-label=\"Message the errand agent\"]:focus"
          ],
          "options": {
            "count": 1
          },
          "note": "focus is on the new chat's composer"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Options for ac servicing in HSR Layout",
            "state": "visible"
          },
          "note": "the first turn searched at once"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.service",
                "equals": "ac_servicing"
              },
              {
                "path": "errand.area",
                "equals": "HSR Layout"
              },
              {
                "path": "errand.timeWindow.from",
                "equals": "2026-11-04"
              }
            ]
          },
          "note": "the new chat's errand holds the job"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/trace"
          ],
          "options": {
            "as": "operator",
            "expect": {
              "path": "events[*].name",
              "includes": "new errand card → errand: service, area, timeWindow"
            }
          },
          "note": "drafted before the first model turn (trace event)"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/handoffs"
          ],
          "options": {
            "expect": [
              {
                "path": "startedFrom.service",
                "equals": "plumber"
              },
              {
                "path": "startedFrom.area",
                "equals": "Koramangala"
              }
            ]
          },
          "note": "the link is on the backend"
        },
        {
          "command": "screenshot",
          "args": [
            "new-chat-light.png"
          ],
          "options": {
            "viewport": true
          }
        },
        {
          "command": "click",
          "options": {
            "role": "link",
            "name": "Open your Koramangala plumber chat"
          }
        },
        {
          "command": "assert",
          "options": {
            "text": "Moved to a new chat"
          },
          "note": "the old chat's card turned into the moved line",
          "args": [
            "body"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "count": 0
          },
          "note": "the card is gone"
        },
        {
          "command": "reload"
        },
        {
          "command": "assert",
          "options": {
            "role": "link",
            "name": "Open the new chat",
            "state": "visible"
          },
          "note": "after a reload it still reads Moved to a new chat · Open"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "New errand",
            "count": 0
          },
          "note": "and no card comes back"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.state",
                "equals": "done"
              },
              {
                "path": "errand.service",
                "equals": "plumber"
              }
            ]
          },
          "note": "the old booking's errand is unchanged"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": {
              "path": "bookings[*].bookingId",
              "includes": "bkg_0002"
            }
          },
          "note": "the plumber booking still stands"
        },
        {
          "command": "screenshot",
          "args": [
            "moved-line-light.png"
          ],
          "options": {
            "viewport": true
          }
        }
      ]
    },
