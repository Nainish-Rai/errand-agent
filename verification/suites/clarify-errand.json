{
  "version": 1,
  "title": "Clarify errand: one question about the area, quick-reply chips, tagged options and traced state transitions",
  "feature": "clarify-errand",
  "description": "Ticket 04. \"I need a plumber this week\" misses only the area: the agent asks one question about it, the chat offers area quick-reply chips, a tap answers it, the agent shows options tagged Best match / Cheapest / Earliest, and the trace panel (open before the first message) shows every errand state transition.",
  "scenarios": [
    {
      "id": "one-question-chips-and-transitions",
      "title": "Plumber this week: one area question with chips; tapping Koramangala shows tagged options; the open trace panel lists the transitions",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "default",
              "seed": 42
            }
          },
          "note": "seed the world: default scenario, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "update_errand",
                            "input": {
                              "service": "plumber",
                              "time_window": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Which area of Bengaluru should the plumber come to?"
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "update_errand",
                            "input": {
                              "area": "Koramangala"
                            }
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Here are the best match, the cheapest and the earliest plumber in Koramangala this week."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "load the clarifying conversation into the scripted model (the scenarios/clarify/missing-area-asks-one-question eval's turns)"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Show trace",
            "count": 0
          },
          "note": "the person's chat has no trace toggle (ticket 19)"
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "I need a plumber this week"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Which area of Bengaluru should the plumber come to?"
          },
          "note": "exactly one question, about the area"
        },
        {
          "command": "assert",
          "options": {
            "role": "group",
            "name": "Quick replies: Area",
            "state": "visible"
          },
          "note": "area quick replies render as chips under the question"
        },
        {
          "command": "assert",
          "args": [
            "role=group[name=\"Quick replies: Area\"] >> role=button"
          ],
          "options": {
            "count": 4
          },
          "note": "four area chips"
        },
        {
          "command": "assert",
          "args": [
            "role=group[name^=\"Quick replies\"]"
          ],
          "options": {
            "count": 1
          },
          "note": "no chips for any other field"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.missing",
                "equals": [
                  "area"
                ]
              },
              {
                "path": "errand.question.fields",
                "equals": [
                  "area"
                ]
              },
              {
                "path": "errand.state",
                "equals": "gathering"
              },
              {
                "path": "errand.service",
                "equals": "plumber"
              }
            ]
          },
          "note": "world state: only the area is missing"
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Koramangala"
          }
        },
        {
          "command": "assert",
          "args": [
            "role=region[name=\"Options for plumber in Koramangala\"] >> role=listitem"
          ],
          "options": {
            "count": 2
          },
          "note": "two options after the chip answered the question: one plumber is both best match and earliest in this world"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Options for plumber in Koramangala",
            "text": "Best match"
          },
          "note": "tagged Best match"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Options for plumber in Koramangala",
            "text": "Cheapest"
          },
          "note": "tagged Cheapest"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Options for plumber in Koramangala",
            "text": "Earliest"
          },
          "note": "tagged Earliest"
        },
        {
          "command": "assert",
          "options": {
            "role": "group",
            "name": "Quick replies: Area",
            "count": 0
          },
          "note": "the chips are gone once answered"
        },
        {
          "command": "goto",
          "args": [
            "/ops/sessions/current"
          ]
        },
        {
          "command": "fill",
          "options": {
            "label": "Operator token",
            "value": "{{operator-token}}"
          }
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Sign in"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Errand states",
            "text": "start → gathering"
          },
          "note": "the operator console's trace panel shows the session's first transition"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Errand states",
            "text": "gathering → searching"
          },
          "note": "the panel shows the search starting"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Errand states",
            "text": "searching → choosing"
          },
          "note": "and the options being shown"
        },
        {
          "command": "assert",
          "options": {
            "role": "complementary",
            "name": "Run trace",
            "text": "5 model calls · 3 tool calls"
          },
          "note": "the waterfall counts both turns"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.state",
                "equals": "choosing"
              },
              {
                "path": "errand.area",
                "equals": "Koramangala"
              },
              {
                "path": "errand.missing",
                "equals": []
              }
            ]
          },
          "note": "world state: the errand is choosing with the area filled"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/trace"
          ],
          "options": {
            "as": "operator",
            "expect": [
              {
                "path": "events[*].name",
                "equals": [
                  "model context",
                  "start → gathering",
                  "model context",
                  "run needs_user",
                  "model context",
                  "model context",
                  "gathering → searching",
                  "searching → choosing",
                  "model context",
                  "run needs_user"
                ]
              }
            ]
          },
          "note": "world state: every transition is in the trace, each run ends with its typed outcome (ticket 08), and every model call logged the context it was sent (ticket 12): both runs leave the next move to the person"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": null
            },
            "expect": {
              "path": "loaded",
              "equals": false
            }
          },
          "note": "unload the script so later suites get the default search responder"
        }
      ]
    }
  ]
}
