{
  "version": 1,
  "title": "Run budget: a model that never stops is cut off and the person sees why; a tool error ends the run with a message",
  "feature": "run-budget",
  "description": "Ticket 08. The scripted model loops forever (it reads the errand on every step). With the run limited to four model turns, three tool calls run, the fourth is refused, and the chat shows the budget-exhausted message as the reply; the trace holds the run_outcome event. Then the world's search is made to throw: the run ends failed, the chat shows the failure message, and the errand is failed.",
  "scenarios": [
    {
      "id": "looping-model-stops-with-budget-message",
      "title": "A model that loops forever stops at four model turns and the chat shows the budget-exhausted message",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "default",
              "seed": 42
            }
          },
          "note": "seed the world: default scenario, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/run-limits"
          ],
          "options": {
            "body": {
              "limits": {
                "modelTurns": 4
              }
            }
          },
          "note": "limit each run to four model turns"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "get_errand",
                            "input": {}
                          }
                        ]
                      }
                    ],
                    "loop": true
                  }
                ]
              }
            }
          },
          "note": "load a model that never stops: every step calls get_errand again"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "find a plumber in Koramangala this week"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "I stopped working on this because it reached the most steps one request may take (4)."
          },
          "note": "the person sees why the agent stopped, as the reply"
        },
        {
          "command": "assert",
          "options": {
            "role": "button",
            "name": "Stop",
            "count": 0
          },
          "note": "the chat is idle again: the run ended, it did not hang"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/trace"
          ],
          "options": {
            "as": "operator",
            "expect": [
              {
                "path": "totals.modelCalls",
                "equals": 4
              },
              {
                "path": "totals.toolCalls",
                "equals": 3
              },
              {
                "path": "events[*].name",
                "includes": "run budget_exhausted"
              }
            ]
          },
          "note": "world state: four model calls, three tool calls, and the run's typed outcome in the trace"
        },
        {
          "command": "goto",
          "args": [
            "/ops/sessions/current"
          ]
        },
        {
          "command": "fill",
          "options": {
            "label": "Operator token",
            "value": "{{operator-token}}"
          }
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Sign in"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "complementary",
            "name": "Run trace",
            "text": "4 model calls · 3 tool calls"
          },
          "note": "the operator console's trace panel shows the run stopped at the cap"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": null
            },
            "expect": {
              "path": "loaded",
              "equals": false
            }
          },
          "note": "unload the script so later suites get the default search responder"
        },
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "default",
              "seed": 42
            },
            "expect": {
              "path": "scenario",
              "equals": "default"
            }
          },
          "note": "reseed the world, which also restores the default run limits and clears the world fault"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/run-limits"
          ],
          "options": {
            "body": {
              "limits": null
            },
            "expect": {
              "path": "limits.modelTurns",
              "equals": 16
            }
          },
          "note": "the default limits are back for later suites"
        }
      ]
    },
    {
      "id": "tool-error-ends-run-failed",
      "title": "The world's search throws: the run ends failed, the chat explains, and the errand is failed",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "default",
              "seed": 42
            }
          },
          "note": "seed the world: default scenario, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/world-fault"
          ],
          "options": {
            "body": {
              "fault": {
                "kind": "throw",
                "operation": "searchProviders"
              }
            }
          },
          "note": "make the world's search throw a TypeError (dev-only fault)"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "update_errand",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "time_window": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "search_providers",
                            "input": {
                              "service": "plumber",
                              "area": "Koramangala",
                              "date_range": {
                                "from": "2026-11-04",
                                "to": "2026-11-10"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Here are the plumbers in Koramangala with free slots this week."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "load the scenarios/budget/unexpected-tool-error eval's turns"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "find a plumber in Koramangala this week"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Something went wrong on my side, so I stopped here without taking any further action."
          },
          "note": "the person sees the failure message as the reply"
        },
        {
          "command": "assert",
          "args": [
            "text=Here are the plumbers"
          ],
          "options": {
            "count": 0
          },
          "note": "the model never got to answer as if the search had worked"
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "The search for plumber in Koramangala failed."
          },
          "note": "the failed search shows as failed, not as a search still running"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/errand"
          ],
          "options": {
            "expect": [
              {
                "path": "errand.state",
                "equals": "failed"
              }
            ]
          },
          "note": "world state: the errand is failed"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/trace"
          ],
          "options": {
            "as": "operator",
            "expect": [
              {
                "path": "totals.toolCalls",
                "equals": 2
              },
              {
                "path": "events[*].name",
                "includes": "run failed"
              },
              {
                "path": "events[*].name",
                "includes": "gathering → failed"
              }
            ]
          },
          "note": "world state: nothing ran after the error, and the trace has the failed outcome"
        },
        {
          "command": "goto",
          "args": [
            "/ops/sessions/current"
          ]
        },
        {
          "command": "fill",
          "options": {
            "label": "Operator token",
            "value": "{{operator-token}}"
          }
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Sign in"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Errand states",
            "text": "gathering → failed"
          },
          "note": "the operator console's trace panel shows the errand failing"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": null
            },
            "expect": {
              "path": "loaded",
              "equals": false
            }
          },
          "note": "unload the script so later suites get the default search responder"
        },
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "default",
              "seed": 42
            },
            "expect": {
              "path": "scenario",
              "equals": "default"
            }
          },
          "note": "reseed the world, which also restores the default run limits and clears the world fault"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/run-limits"
          ],
          "options": {
            "body": {
              "limits": null
            },
            "expect": {
              "path": "limits.modelTurns",
              "equals": 16
            }
          },
          "note": "the default limits are back for later suites"
        }
      ]
    }
  ]
}
