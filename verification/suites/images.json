    {
      "id": "service-choice-cards",
      "title": "Which AC service? shows a photo, the world's price and description per option, and a tap answers",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "happy_path",
              "seed": 42
            }
          },
          "note": "seed the world: happy_path, seed 42"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/memory"
          ],
          "options": {
            "body": {
              "facts": []
            }
          },
          "note": "start with nothing remembered"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "ask_ui",
                            "input": {
                              "ui": "root = Stack([q])\nq = ServiceChoices(\"Which AC service?\", [ServiceChoice(\"ac_gas_refill\", \"Gas refill\"), ServiceChoice(\"ac_deep_clean\", \"Deep clean\"), ServiceChoice(\"ac_repair\", \"Repair\")])"
                            }
                          }
                        ]
                      },
                      {
                        "text": "Which AC service do you need? Prices are for one split AC."
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "text": "Deep clean it is."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "ask which AC service, then acknowledge"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "My AC needs servicing before the weekend"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "options": {
            "state": "visible"
          },
          "args": [
            "role=region[name=\"Which AC service?\"] >> role=img[name=\"Technician connecting a gas cylinder to an outdoor AC unit\"]"
          ],
          "note": "gas refill has its 4:3 photo"
        },
        {
          "command": "assert",
          "options": {
            "state": "visible"
          },
          "args": [
            "role=region[name=\"Which AC service?\"] >> role=img[name=\"Hands lifting an AC filter grille to clean it\"]"
          ],
          "note": "deep clean has its photo"
        },
        {
          "command": "assert",
          "options": {
            "state": "visible"
          },
          "args": [
            "role=region[name=\"Which AC service?\"] >> role=img[name=\"Hands working on the pipes of an AC unit\"]"
          ],
          "note": "repair has its photo"
        },
        {
          "command": "assert",
          "options": {
            "text": "from ₹599"
          },
          "args": [
            "role=region[name=\"Which AC service?\"]"
          ],
          "note": "the world's price, not the model's"
        },
        {
          "command": "assert",
          "options": {
            "text": "Prices are for one split AC."
          },
          "args": [
            "body"
          ],
          "note": "the turn finished"
        },
        {
          "command": "screenshot",
          "args": [
            "service-choice.png"
          ]
        },
        {
          "command": "click",
          "args": [
            "role=region[name=\"Which AC service?\"] >> css=[data-option-id=ac_deep_clean]"
          ]
        },
        {
          "command": "assert",
          "options": {
            "text": "Deep clean it is."
          },
          "args": [
            "body"
          ],
          "note": "the tap answered as the person and the agent went on"
        },
        {
          "command": "network",
          "options": {
            "resourceType": "image",
            "notPath": "/_next/static/media/*",
            "expectCount": 0
          },
          "note": "every image the page requested is a bundled registry file (/_next/static/media/); nothing else was fetched"
        }
      ]
    },
