{
  "version": 1,
  "title": "Booking changes: cancel and reschedule through the approval card, and the same provider as last time",
  "feature": "booking-changes",
  "description": "Ticket 10. Moving the AC service shows a fixed reschedule card with the old and new times and one tap moves it once; a refused new time moves nothing and puts the closest free time on a fresh card that needs its own tap; a cancellation card shows the fee, a 503 is retried and Cancelled appears only once the booking's status shows it; the last electrician is proposed with no slot before 10:00. Each checked against GET /api/v1/bookings and the ledger.",
  "scenarios": [
    {
      "id": "reschedule-shows-old-and-new-then-moves-once",
      "title": "Move my AC servicing to Saturday: the card shows Mon 9 Nov 11:00 → Sat 7 Nov 2:00 pm; Approve moves it once",
      "theme": "dark",
      "viewport": "desktop",
      "setup": [
        {
          "command": "api",
          "args": [
            "POST",
            "/api/v1/dev/scenario"
          ],
          "options": {
            "body": {
              "scenario": "happy_path",
              "seed": 42
            }
          },
          "note": "seed the world: happy_path, seed 42 (the person's AC service bkg_seed_3 is on Mon 9 Nov at 11:00)"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/memory"
          ],
          "options": {
            "body": {
              "facts": []
            }
          },
          "note": "start with empty memory"
        },
        {
          "command": "api",
          "args": [
            "PUT",
            "/api/v1/dev/model-script"
          ],
          "options": {
            "body": {
              "script": {
                "turns": [
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "list_bookings",
                            "input": {}
                          }
                        ]
                      },
                      {
                        "toolCalls": [
                          {
                            "name": "find_reschedule_slots",
                            "input": {
                              "booking_id": "bkg_seed_3",
                              "from": "2026-11-07",
                              "to": "2026-11-07"
                            }
                          }
                        ]
                      },
                      {
                        "text": "Your AC service with Ravi Aircon Experts is on Mon 9 Nov at 11:00 am. On Saturday they're free at 8 am, 2 pm, 3 pm and 6 pm. Which works?"
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "propose_action",
                            "input": {
                              "action": "reschedule",
                              "booking_id": "bkg_seed_3",
                              "slot": {
                                "start": "2026-11-07T14:00:00+05:30",
                                "end": "2026-11-07T15:00:00+05:30"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "text": "Check the card: it moves the visit from Mon 9 Nov 11:00 am to Sat 7 Nov 2:00 pm. Tap Approve if that's right."
                      }
                    ]
                  },
                  {
                    "steps": [
                      {
                        "toolCalls": [
                          {
                            "name": "execute_proposal",
                            "input": {}
                          }
                        ]
                      },
                      {
                        "text": "Moved: Ravi Aircon Experts, now Sat 7 Nov at 2:00 pm IST. Booking ID bkg_seed_3."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "note": "load the reschedule conversation into the scripted model"
        }
      ],
      "steps": [
        {
          "command": "goto",
          "args": [
            "/chat"
          ]
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "Move my AC servicing to Saturday"
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Which works?"
          },
          "note": "the agent found the booking and Saturday's free times"
        },
        {
          "command": "fill",
          "options": {
            "role": "textbox",
            "name": "Message the errand agent",
            "value": "2 pm works."
          }
        },
        {
          "command": "key",
          "args": [
            "Enter"
          ]
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Tap Approve if that's right."
          },
          "note": "the reschedule card turn finished"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve reschedule",
            "text": "Mon, 9 Nov, 11:00 am IST"
          },
          "note": "the card shows the old time"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve reschedule",
            "text": "Sat, 7 Nov, 2:00 pm IST"
          },
          "note": "and the new time"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve reschedule",
            "text": "bkg_seed_3"
          },
          "note": "and the booking it moves"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve reschedule",
            "text": "Valid"
          },
          "note": "the card's countdown is its own window: a move holds no slot"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": {
              "path": "bookings[*].slot.start",
              "includes": "2026-11-09T11:00:00+05:30"
            }
          },
          "note": "world state: nothing moved before the tap"
        },
        {
          "command": "screenshot",
          "args": [
            "reschedule-card.png"
          ]
        },
        {
          "command": "click",
          "options": {
            "role": "button",
            "name": "Approve move"
          }
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Moved",
            "text": "Sat, 7 Nov, 2:00 pm IST",
            "timeoutMs": 20000
          },
          "note": "the receipt shows the move the booking's status confirmed"
        },
        {
          "command": "assert",
          "options": {
            "role": "region",
            "name": "Approve reschedule",
            "text": "You approved the move."
          },
          "note": "the approved card names what was approved, not a charge"
        },
        {
          "command": "assert",
          "args": [
            "body"
          ],
          "options": {
            "text": "Moved: Ravi Aircon Experts"
          },
          "note": "the agent's reply relays it"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": [
              {
                "path": "bookings[*].slot.start",
                "includes": "2026-11-07T14:00:00+05:30"
              },
              {
                "path": "bookings[*].status",
                "equals": [
                  "completed",
                  "completed",
                  "upcoming"
                ]
              },
              {
                "path": "bookings[*].changes[*].action",
                "equals": [
                  "reschedule"
                ]
              },
              {
                "path": "bookings[*].changes[*].grantConsumed",
                "equals": [
                  true
                ]
              }
            ]
          },
          "note": "world state: the booking is on Saturday 2 pm, its one reschedule grant consumed"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/sessions/current/action-intents"
          ],
          "options": {
            "expect": [
              {
                "path": "intents[*].action",
                "equals": [
                  "reschedule"
                ]
              },
              {
                "path": "intents[*].state",
                "equals": [
                  "confirmed"
                ]
              },
              {
                "path": "intents[*].attempts",
                "equals": [
                  1
                ]
              }
            ]
          },
          "note": "world state: one reschedule intent, confirmed after one attempt"
        }
      ]
    },
    {
