          },
          "note": "the tap on the fresh card moved it"
        },
        {
          "command": "api",
          "args": [
            "GET",
            "/api/v1/bookings"
          ],
          "options": {
            "expect": [
              {
                "path": "bookings[*].slot.start",
                "includes": "2026-11-07T14:00:00+05:30"
              },
              {
                "path": "bookings[*].changes[*].status",
                "equals": [
                  "failed",
                  "executed"
                ]
              },
              {
                "path": "bookings[*].changes[*].grantConsumed",
                "equals": [
                  true,
                  true
                ]
              }
            ]
          },
          "note": "world state: the booking is at 2 pm; each move had its own consumed grant"
        }
      ]
    },
