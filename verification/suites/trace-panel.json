{
  "version": 1,
  "title": "Trace panel: the operator console shows the waterfall with model and tool spans",
  "feature": "trace-panel",
  "description": "Tickets 03 and 19. The run trace is for operators: the console at /ops/sessions/ID shows the session's transcript beside the trace panel, drawn as a waterfall of the turn's model and tool spans, read from GET /api/v1/sessions/:id/trace with the operator's token, and records every read in the access log. The person's chat no longer has a trace (operator-only-traces.json).",
  "scenarios": [
    {
      "id": "console-shows-waterfall",
      "title": "A person searches; the operator signs in and sees the transcript beside the waterfall with the model calls and the tool call",
      "setup": [
        {
          "command": "api",
          "args": ["PUT", "/api/v1/dev/model-script"],
          "options": { "body": { "script": null } },
          "note": "no scenario script: the scripted model's default search responder answers"
        },
        {
          "command": "api",
          "args": ["POST", "/api/v1/dev/scenario"],
          "options": { "body": { "scenario": "default", "seed": 42 } }
        }
      ],
      "steps": [
        { "command": "goto", "args": ["/chat"] },
        {
          "command": "fill",
          "options": { "role": "textbox", "name": "Message the errand agent", "value": "find a plumber in Koramangala this week" }
        },
        { "command": "key", "args": ["Enter"] },
        { "command": "click", "options": { "role": "button", "name": "See all 8" }, "note": "ticket 17: every provider is behind See all, in a carousel" },
        {
          "command": "assert",
          "args": ["role=region[name=\"Search results for plumber in Koramangala\"] >> role=listitem"],
          "options": { "count": 8 },
          "note": "the person's turn ran"
        },
        { "command": "goto", "args": ["/ops/sessions/current"] },
        {
          "command": "assert",
          "options": { "role": "form", "name": "Operator sign-in", "state": "visible" },
          "note": "the console opens only after an operator signs in"
        },
        { "command": "fill", "options": { "label": "Operator token", "value": "{{operator-token}}" } },
        { "command": "click", "options": { "role": "button", "name": "Sign in" } },
        {
          "command": "assert",
          "options": { "role": "complementary", "name": "Run trace", "text": "2 model calls · 1 tool calls" },
          "note": "the summary counts the turn, with its tokens and estimated cost"
        },
        {
          "command": "assert",
          "options": { "role": "tree", "name": "Steps", "state": "visible" },
          "note": "the waterfall renders"
        },
        {
          "command": "assert",
          "args": ["role=tree[name=\"Steps\"] >> role=treeitem[name*=\"chat errand-script\"]"],
          "options": { "count": 2 },
          "note": "two model spans (chat errand-script)"
        },
        {
          "command": "assert",
          "args": ["role=tree[name=\"Steps\"] >> role=treeitem[name*=\"search_providers tool\"]"],
          "options": { "count": 1 },
          "note": "one tool span (search_providers)"
        },
        {
          "command": "assert",
          "options": { "role": "region", "name": "Errand states", "text": "searching → choosing" },
          "note": "the errand's transitions show beside the waterfall"
        },
        {
          "command": "assert",
          "options": { "role": "region", "name": "Transcript", "text": "find a plumber in Koramangala this week" },
          "note": "the read-only transcript sits beside the trace"
        },
        {
          "command": "assert",
          "args": ["role=list[name=\"Messages\"] >> role=listitem"],
          "options": { "count": 2 },
          "note": "the person's message and the agent's reply"
        },
        {
          "command": "assert",
          "options": { "role": "region", "name": "Operator access log", "text": "verify-operator" },
          "note": "the operator's own reads are in the access log"
        },
        {
          "command": "api",
          "args": ["GET", "/api/v1/sessions/current/trace"],
          "options": {
            "as": "operator",
            "expect": [
              { "path": "spans[*].kind", "includes": "model" },
              { "path": "spans[*].kind", "includes": "tool" },
              { "path": "totals.modelCalls", "equals": 2 },
              { "path": "totals.toolCalls", "equals": 1 }
            ]
          },
          "note": "world state: the backend's trace matches the waterfall"
        },
        {
          "command": "api",
          "args": ["GET", "/api/v1/ops/sessions/current/reads"],
          "options": {
            "as": "operator",
            "expect": [
              { "path": "reads[*].kind", "includes": "trace" },
              { "path": "reads[*].kind", "includes": "context" },
              { "path": "reads[*].kind", "includes": "transcript" },
              { "path": "reads[*].operatorId", "includes": "verify-operator" }
            ]
          },
          "note": "world state: every read the console made is audited under the operator"
        }
      ]
    },
    {
      "id": "console-lists-sessions",
      "title": "The console's list shows the person's session and opens it",
      "setup": [
        {
          "command": "api",
          "args": ["PUT", "/api/v1/dev/model-script"],
          "options": { "body": { "script": null } }
        },
        {
          "command": "api",
          "args": ["POST", "/api/v1/dev/scenario"],
          "options": { "body": { "scenario": "default", "seed": 42 } }
        }
      ],
      "steps": [
        { "command": "goto", "args": ["/chat"] },
        {
          "command": "fill",
          "options": { "role": "textbox", "name": "Message the errand agent", "value": "find a plumber in Koramangala this week" }
        },
        { "command": "key", "args": ["Enter"] },
        {
          "command": "assert",
          "options": { "role": "region", "name": "Options for plumber in Koramangala", "state": "visible" },
          "note": "the person's turn ran"
        },
        { "command": "goto", "args": ["/ops"] },
        { "command": "fill", "options": { "label": "Operator token", "value": "{{operator-token}}" } },
        { "command": "click", "options": { "role": "button", "name": "Sign in" } },
        {
          "command": "assert",
          "args": ["role=list[name=\"Sessions\"] >> role=link >> nth=0"],
          "options": { "text": "Plumber · Koramangala" },
          "note": "the newest session is first, named by its errand"
        },
        { "command": "click", "args": ["role=list[name=\"Sessions\"] >> role=link >> nth=0"] },
        {
          "command": "assert",
          "options": { "role": "complementary", "name": "Run trace", "text": "2 model calls · 1 tool calls" },
          "note": "the link opens that session's trace"
        }
      ]
    },
    {
      "id": "console-follows-a-new-turn",
      "title": "After the person sends another message, the console shows the new turn",
      "setup": [
        {
          "command": "api",
          "args": ["PUT", "/api/v1/dev/model-script"],
          "options": { "body": { "script": null } }
        },
        {
          "command": "api",
          "args": ["POST", "/api/v1/dev/scenario"],
          "options": { "body": { "scenario": "default", "seed": 42 } }
        }
      ],
      "steps": [
        { "command": "goto", "args": ["/chat"] },
        {
          "command": "fill",
          "options": { "role": "textbox", "name": "Message the errand agent", "value": "find a plumber in Koramangala this week" }
        },
        { "command": "key", "args": ["Enter"] },
        {
          "command": "assert",
          "options": { "role": "region", "name": "Options for plumber in Koramangala", "state": "visible" },
          "note": "turn one ran"
        },
        { "command": "goto", "args": ["/ops/sessions/current"] },
        { "command": "fill", "options": { "label": "Operator token", "value": "{{operator-token}}" } },
        { "command": "click", "options": { "role": "button", "name": "Sign in" } },
        {
          "command": "assert",
          "options": { "role": "complementary", "name": "Run trace", "text": "2 model calls · 1 tool calls" },
          "note": "the console shows turn one"
        },
        { "command": "goto", "args": ["/chat/current"] },
        {
          "command": "fill",
          "options": { "role": "textbox", "name": "Message the errand agent", "value": "find an electrician in Jayanagar this week" }
        },
        { "command": "key", "args": ["Enter"] },
        {
          "command": "assert",
          "args": ["text=I found 8 providers. The top options:"],
          "options": { "count": 2, "timeoutMs": 15000 },
          "note": "turn two ran in the same chat (the scripted responder answers any search the same way)"
        },
        { "command": "goto", "args": ["/ops/sessions/current"] },
        {
          "command": "assert",
          "args": ["role=list[name=\"Messages\"] >> role=listitem"],
          "options": { "count": 4, "timeoutMs": 5000 },
          "note": "the operator is still signed in in this tab, and the transcript has both turns"
        },
        {
          "command": "assert",
          "options": { "role": "complementary", "name": "Run trace", "text": "3 model calls · 1 tool calls", "timeoutMs": 5000 },
          "note": "the trace counts turn two's model call (it answered from the first search)"
        }
      ]
    }
  ]
}
